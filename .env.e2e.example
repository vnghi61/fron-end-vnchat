# Cấu hình E2E (Playwright) – sao chép thành .env.e2e (gitignore). Chỉ dùng tài khoản QA của backend LOCAL/STAGING,
# không bao giờ dùng tài khoản người dùng thật. Hướng dẫn tạo tài khoản + vai trò: e2e/README.md.
E2E_BASE_URL=http://localhost:5174
E2E_API_URL=http://localhost:5001
# Trang host thử nhúng – phải khác SITE với E2E_BASE_URL (127.0.0.1 ≠ localhost)
E2E_HOST_URL=http://127.0.0.1:5180
# A = admin + member; B, C = agent + member
E2E_USER_A=binh.qa@vnchat.test
E2E_USER_B=cuong.qa@vnchat.test
E2E_USER_C=dung.qa@vnchat.test
QA_PASSWORD=
