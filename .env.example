# URL API backend (rỗng = cùng origin / qua reverse proxy). Ví dụ: https://back-end-vnchat.onrender.com
VITE_API_URL=
# Dev: backend mà Vite proxy /api và /socket.io tới
VITE_DEV_API_TARGET=http://localhost:5001
# cookie (FE & API cùng site, cookie httpOnly) | bearer (khác site / iframe bên thứ ba – lưu token trong storage của origin này)
VITE_AUTH_TRANSPORT=cookie
# Origin được phép nhúng /embed và /widget và nhận postMessage (phân tách dấu phẩy, không wildcard)
VITE_EMBED_PARENT_ORIGINS=
