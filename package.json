{
  "name": "vnchat-web",
  "private": true,
  "version": "2.0.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=setup --project=chromium",
    "e2e:matrix": "playwright test --project=setup --project=chromium --project=mobile-chrome --project=firefox && npm run e2e:webkit",
    "e2e:webkit": "playwright test --project=setup --project=webkit --project=mobile-safari",
    "e2e:report": "playwright show-report",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json}\"",
    "gen:api": "node scripts/gen-api.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && vite build && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "3.14.13",
    "axios": "^1.8.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "i18next": "25.10.10",
    "lucide-react": "^0.488.0",
    "radix-ui": "1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "16.6.6",
    "react-router-dom": "^7.5.0",
    "socket.io-client": "^4.8.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.1.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^6.2.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
